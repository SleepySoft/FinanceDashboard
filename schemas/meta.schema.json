{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "data/{code}/meta.json — 股票静态元数据",
  "type": "object",
  "required": ["code", "name"],
  "properties": {
    "code": { "type": "string", "pattern": "^[0-9A-Z]+\\.(SH|SZ|BJ|HK)$" },
    "name": { "type": "string" },
    "sector": { "type": "string" },
    "type": { "type": "string" },
    "added_at": { "type": "string" }
  }
}
