{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "data/{code}/holdings.json — 持仓与交易记录（顶层键缺失时后端按空处理）",
  "type": "object",
  "properties": {
    "trades": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["date", "type", "price", "quantity"],
        "properties": {
          "id":    { "type": "string" },
          "date":  { "type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$" },
          "time":  { "type": "string" },
          "type":  { "type": "string", "enum": ["buy", "sell"] },
          "price": { "type": "number" },
          "quantity": { "type": "number" },
          "fee":   { "type": "number" },
          "note":  { "type": "string" },
          "idempotent_key": { "type": "string" }
        }
      }
    },
    "t_trades": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": { "type": "string" },
          "type": { "type": "string", "description": "如 正T / 反T / 正T(跨天) 等，不做枚举限制" },
          "quantity": { "type": "number" },
          "profit": { "type": "number" },
          "buy_date": { "type": "string" }, "buy_time": { "type": "string" },
          "buy_price": { "type": "number" }, "buy_trade_id": { "type": "string" },
          "sell_date": { "type": "string" }, "sell_time": { "type": "string" },
          "sell_price": { "type": "number" }, "sell_trade_id": { "type": "string" }
        }
      }
    },
    "adj_events": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["date", "type"],
        "properties": {
          "date": { "type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$" },
          "type": { "type": "string", "enum": ["split", "bonus", "dividend"] },
          "ratio": { "type": "number" },
          "dividend_per_share": { "type": "number" },
          "note": { "type": "string" }
        }
      }
    },
    "summary": { "type": "object" }
  }
}
