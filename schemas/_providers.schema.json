{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "data/_providers.json — 交易数据网站跳转配置",
  "type": "object",
  "properties": {
    "default_provider": { "type": "string" },
    "providers": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "name"],
        "properties": {
          "id":   { "type": "string" },
          "name": { "type": "string" },
          "icon": { "type": "string" },
          "links": {
            "type": "object",
            "additionalProperties": { "type": "string", "description": "URL 模板，可含 {symbol_*} 占位符" }
          }
        }
      }
    }
  }
}
